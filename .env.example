# Copy this to .env for local development
# For production (Render), set these in the Render dashboard → Environment

# PostgreSQL connection string — get this from Neon (https://neon.tech)
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Random secret used to sign JWTs — generate one at https://generate-secret.vercel.app/32
SESSION_SECRET=your-random-secret-here

# Push notification keys (VAPID) — keep your existing ones from Replit
VAPID_PUBLIC_KEY=BB0GuW1AusBee-QZ9PTiRbHXyu591p99RdwwciXDq-7kTOFGS-nZjWYUxcOqyGnh8dxildXsERwCcSz6kWN31Pw
VAPID_PRIVATE_KEY=Ta_sHkSqSu6chCberrh563qW1jamoGfRAnkHkmcg3bU
VITE_VAPID_PUBLIC_KEY=BB0GuW1AusBee-QZ9PTiRbHXyu591p99RdwwciXDq-7kTOFGS-nZjWYUxcOqyGnh8dxildXsERwCcSz6kWN31Pw

# Leave empty to allow all origins, or set to your Render app URL
CORS_ORIGIN=
